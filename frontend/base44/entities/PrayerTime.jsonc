{
  "name": "PrayerTime",
  "type": "object",
  "properties": {
    "synagogue_id": {
      "type": "string",
      "description": "Reference to the Synagogue entity"
    },
    "name": {
      "type": "string",
      "description": "Prayer name (e.g. Shacharit, Mincha, Arvit)"
    },
    "time": {
      "type": "string",
      "description": "Prayer time (HH:MM format)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "everyday"
      ],
      "description": "Which days this prayer time applies to (everyday, weekdays, sunday, monday, tuesday, wednesday, thursday, friday, saturday)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this prayer time is currently active"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Order for display sorting"
    }
  },
  "required": [
    "name",
    "time"
  ]
}