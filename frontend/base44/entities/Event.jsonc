{
  "name": "Event",
  "type": "object",
  "properties": {
    "synagogue_id": {
      "type": "string",
      "description": "Reference to the Synagogue entity"
    },
    "name": {
      "type": "string",
      "description": "Event name"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Event date"
    },
    "time": {
      "type": "string",
      "description": "Event time"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "image_url": {
      "type": "string",
      "description": "Optional poster image URL shown on the display when the event is relevant"
    }
  },
  "required": [
    "name",
    "date"
  ]
}